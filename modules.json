        "responsibility": "Provide code-defined recurring schedules, immutable compilation, bounded execution, fenced multi-replica coordination, explicit dispatch, and observable lifecycle integration.",
        "non_goals": [
          "Provide exactly-once execution, a workflow engine, a durable queue, arbitrary command execution, or a Kubernetes controller.",
          "Own application jobs, queue workers, service processes, PostgreSQL pools, Valkey clients, credentials, or telemetry backends."
        ],
        "public_package_identifier": "scheduler",
        "primary_entry_packages": [
          "github.com/faustbrian/go-scheduler"
        ],
        "package_selection": {
          "github.com/faustbrian/go-scheduler": "Use for schedule definitions, immutable registry compilation, bounded occurrence selection, fenced execution coordination, and runner lifecycle.",
          "github.com/faustbrian/go-scheduler/cron": "Use to compile the scheduler's bounded five-field or optional-seconds cron expressions without constructing a runner.",
          "github.com/faustbrian/go-scheduler/history": "Use for a bounded in-process observer buffer of scheduler lifecycle events.",
          "github.com/faustbrian/go-scheduler/idempotency": "Use to wrap scheduler execution with durable idempotency ownership and completion policy.",
          "github.com/faustbrian/go-scheduler/lease": "Use to implement or consume the scheduler's fenced lease-store contract.",
          "github.com/faustbrian/go-scheduler/lease/conformance": "Use when implementing a lease store to verify the public fencing and lifecycle contract.",
          "github.com/faustbrian/go-scheduler/memory": "Use for deterministic process-local lease coordination where restart loss is acceptable.",
          "github.com/faustbrian/go-scheduler/postgres": "Use for fenced multi-replica leases backed by a caller-owned PostgreSQL pool.",
          "github.com/faustbrian/go-scheduler/queue": "Use to dispatch durable scheduled work through a caller-selected go-queue backend.",
          "github.com/faustbrian/go-scheduler/schedulercli": "Use to expose bounded scheduler inspection and fenced recovery through a caller-owned CLI application.",
          "github.com/faustbrian/go-scheduler/schedulerhttp": "Use to expose bounded scheduler inspection and fenced recovery through caller-authenticated HTTP routing.",
          "github.com/faustbrian/go-scheduler/schedulerservice": "Use to compose runner and drain ownership into a caller-owned go-service lifecycle plan.",
          "github.com/faustbrian/go-scheduler/schedulertest": "Use in tests for deterministic clock control and schedule execution evidence.",
          "github.com/faustbrian/go-scheduler/telemetry": "Use for bounded scheduler logs, metrics, and traces through caller-configured observability facilities.",
          "github.com/faustbrian/go-scheduler/valkey": "Use for fenced multi-replica leases backed by a caller-owned Valkey client."
        },
